DISCORD_BOT_TOKEN=replace-me
DISCORD_APPLICATION_ID=
DISCORD_INSTALL_PERMISSIONS=309237713920
CONNECTION_STORE_SQLITE_PATH=.state/pixie-connection-store.sqlite
LANGGRAPH_CHECKPOINT_PATH=.state/pixie-langgraph.sqlite
WEB_APP_URL=http://localhost:8000

# Discord bot installation (callback-less bot/applications.commands flow)
# DISCORD_APPLICATION_ID is the application/client ID used in the install URL.
# If omitted, Pixie falls back to DISCORD_OAUTH_CLIENT_ID.
# DISCORD_INSTALL_PERMISSIONS defaults to the minimum needed for the current e2e flow.
# The install flow no longer preselects a guild; Discord lets the installer choose.

# Discord OAuth login (for the settings web app sign-in flow only)
# Create an OAuth2 application at https://discord.com/developers/applications
# Add http://localhost:8000/api/auth/discord/callback as a Redirect URI
# Use this callback only for user login scopes such as identify/email/guilds.
# Do not reuse it for bot or broader application OAuth/install flows.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_CALLBACK_URL=http://localhost:8000/api/auth/discord/callback

# Session cookie signing (Fernet key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SESSION_SECRET_KEY=

# Shared connection/server store
# Local runs default to CONNECTION_STORE_SQLITE_PATH so the web app and bot can
# share per-server settings and credentials across separate processes.
# Supabase remains optional and overrides the local SQLite store when set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Credential encryption (Fernet key — generate same way as SESSION_SECRET_KEY)
CREDENTIALS_ENCRYPTION_KEY=

# Integration provider OAuth callbacks (Notion/GitHub/Vercel/Airtable, not Discord login)
OAUTH_CALLBACK_URL=http://localhost:8000/api/connections/oauth/callback

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=

DISCORD_PRODUCT_MANAGER_DISPLAY_NAME=Pixie PM
DISCORD_PRODUCT_MANAGER_MENTION_TOKENS=@pm,@product-manager
DISCORD_PRODUCT_MANAGER_WEBHOOK_URL=

